{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "termm",
  "version": "0.1.0",
  "identifier": "com.sshai.termm",
  "build": {
    "beforeBuildCommand": "npm run build --prefix web",
    "frontendDist": "assets"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "termm",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "visible": false,
        "backgroundColor": [7, 10, 15, 255]
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
